<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imPokemonDetalle"
            android:layout_width="match_parent"
            android:layout_height="266dp"
            app:srcCompat="@android:drawable/btn_star_big_on" />

        <TextView
            android:id="@+id/txtNombreDetalle"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtNumDetalle"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:textAlignment="center"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="111dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <TextView
                android:id="@+id/txtPesoDetalle"
                android:layout_width="189dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:text="Peso: "
                android:textSize="24sp" />

            <TextView
                android:id="@+id/txtAlturaDetalle"
                android:layout_width="216dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:text="Altura: "
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTiposDetalle"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:textAlignment="center"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txtDescripcionDetalle"
            android:layout_width="match_parent"
            android:layout_height="173dp"
            android:textSize="24sp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>